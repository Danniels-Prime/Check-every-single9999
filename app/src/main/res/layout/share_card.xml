<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_translate"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="12sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvShareLangs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:background="@drawable/bg_lang_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <!-- Original text -->
        <TextView
            android:id="@+id/tvShareOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="8dp" />

        <!-- Arrow divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="8dp" />

        <!-- Translation (main content) -->
        <TextView
            android:id="@+id/tvShareTranslated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="12dp" />

        <!-- Examples label -->
        <TextView
            android:id="@+id/tvShareExamplesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Examples"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:textColor="#888888"
            android:letterSpacing="0.1"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <!-- Examples -->
        <TextView
            android:id="@+id/tvShareExamples"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#444444"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
